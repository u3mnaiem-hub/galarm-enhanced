rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isNotBlocked(targetUid) {
      return !exists(/databases/$(database)/documents/users/$(targetUid)/blocked/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;

      match /notifications/{notifId} {
        allow read, update, delete: if isSignedIn() && request.auth.uid == uid;
        allow create: if false; // Written only by Cloud Functions
      }

      match /blocked/{blockedUid} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /alarms/{alarmId} {
      allow read: if isSignedIn() &&
        (resource.data.ownerId == request.auth.uid ||
         request.auth.uid in resource.data.participantUids);

      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        isNotBlocked(request.resource.data.ownerId);

      allow update, delete: if isSignedIn() &&
        (resource.data.ownerId == request.auth.uid ||
         request.auth.uid in resource.data.participantUids);

      match /participants/{pUid} {
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/alarms/$(alarmId)).data.ownerId == request.auth.uid ||
           request.auth.uid in get(/databases/$(database)/documents/alarms/$(alarmId)).data.participantUids);
        allow write: if isSignedIn() &&
          (request.auth.uid == pUid ||
           get(/databases/$(database)/documents/alarms/$(alarmId)).data.ownerId == request.auth.uid) &&
          isNotBlocked(pUid);
      }

      match /occurrences/{occId} {
        allow read, write: if isSignedIn() &&
          (get(/databases/$(database)/documents/alarms/$(alarmId)).data.ownerId == request.auth.uid ||
           request.auth.uid in get(/databases/$(database)/documents/alarms/$(alarmId)).data.participantUids);
      }

      match /messages/{msgId} {
        allow read, create: if isSignedIn() &&
          (get(/databases/$(database)/documents/alarms/$(alarmId)).data.ownerId == request.auth.uid ||
           request.auth.uid in get(/databases/$(database)/documents/alarms/$(alarmId)).data.participantUids);
      }
    }
  }
}
